<%- include('partials/header', { title: 'Verify your email', preheader: 'Confirm your email to activate your EventHorizon account.' }) %>
<p style="margin: 0 0 12px; font-size: 16px; line-height: 1.5; color: #111827;">
  Hi <%= firstName %>,
</p>
<h1 style="margin: 0 0 16px; font-size: 22px; line-height: 1.3; font-weight: 700; color: #111827;">
  Verify your email address
</h1>
<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #374151;">
  Thanks for signing up for EventHorizon. Please confirm your email address to activate your account.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 20px;">
  <tr>
    <td align="center">
      <a href="<%= verificationUrl %>" style="display: inline-block; padding: 12px 24px; background-color: #111827; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 15px;">
        Verify Email
      </a>
    </td>
  </tr>
</table>
<p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
  Or copy and paste this link into your browser: <%= verificationUrl %>
</p>
<p style="margin: 20px 0 0; font-size: 15px; line-height: 1.6; color: #374151;">
  If you didn't create this account, you can safely ignore this email.
</p>
<%- include('partials/footer') %>